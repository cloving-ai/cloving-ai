{
  "workflow": {
    "workflowId": "develop",
    "effectLimit": 87,
    "capabilities": ["claude", "github"],
    "queue": {
      "everySeconds": 120,
      "lanes": 1,
      "feed": "developFeed"
    },
    "input": {
      "maximumBytes": 65536,
      "fields": {
        "ticket": {
          "type": "ticket"
        }
      }
    }
  },
  "methods": {
    "claude": ["run-turn"],
    "github": [
      "prepare",
      "label",
      "open-pr",
      "wait-review",
      "merge",
      "close-issue",
      "partial-issue",
      "close-pr",
      "issues",
      "issue-states"
    ]
  }
}
