{
  "workflow": {
    "workflowId": "review-day",
    "effectLimit": 10,
    "capabilities": ["command", "claude", "github"],
    "commands": ["report"],
    "schedule": { "everySeconds": 86400, "input": {} },
    "handoffs": ["idea-to-issue"],
    "input": { "maximumBytes": 65536, "fields": {} }
  },
  "methods": {
    "command": ["run:report"],
    "claude": ["run-turn"],
    "github": ["issues", "create-issue", "label", "discard"]
  }
}
