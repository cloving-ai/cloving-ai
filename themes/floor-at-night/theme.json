    },
    "heading": {
      "$value": ["Barlow Semi Condensed", "system-ui", "sans-serif"]
    },
    "code": {
      "$value": [
        "Fira Code",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ]
    }
