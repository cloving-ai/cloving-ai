        }
      },
      "completed": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.122, 0.478, 0.302],
          "hex": "#1F7A4D"
        }
      },
      "failed": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.761, 0.122, 0.196],
