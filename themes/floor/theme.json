  "shape": {
    "$type": "dimension",
    "cut": {
      "$value": {
        "value": 7,
        "unit": "px"
      }
    },
    "radius": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "border": {
      "$value": {
        "value": 1,
        "unit": "px"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "text": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "gap": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "ui": {
      "$value": ["Barlow", "system-ui", "sans-serif"]
    },
    "heading": {
      "$value": ["Barlow Semi Condensed", "system-ui", "sans-serif"]
    },
    "code": {
      "$value": [
        "Fira Code",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ]
    }
  },
  "$extensions": {
    "ai.cloving.theme": {
      "name": "Floor",
      "colorScheme": "light"
    }
  }
}
