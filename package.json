{
  "name": "cloving",
  "version": "0.4.0",
  "private": true,
  "description": "Local durable development workflow service",
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#package": "./package.json"
  },
  "bin": {
    "cloving": "dist/src/cli.js"
  },
  "exports": {
    "./workflows": {
      "types": "./dist/src/workflows.d.ts",
      "import": "./dist/src/workflows.js"
    }
  },
  "files": ["dist/src"],
  "engines": {
    "node": "26.9.0",
    "npm": "11.19.1"
  },
  "os": ["darwin"],
  "cpu": ["arm64"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:workflows": "node tools/compile-workflows.ts",
    "check:setup": "tsc --project tsconfig.json --noEmit",
    "check": "node tools/quality-pending.ts",
    "test:concurrency": "node tools/quality-pending.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@workflow/builders": "5.0.2",
    "typescript": "6.0.3",
    "workflow": "5.1.0"
  },
  "overrides": {
    "@workflow/core": {
      "devalue": "5.9.4",
      "nanoid": "5.1.16"
    }
  }
}
