{
  "name": "cloving",
  "version": "0.4.0",
  "private": true,
  "description": "Local durable development workflow service",
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#package": "./package.json"
  },
  "bin": {
    "cloving": "dist/src/cli.js"
  },
  "exports": {
    "./workflows": {
      "types": "./dist/src/workflows.d.ts",
      "import": "./dist/src/workflows.js"
    },
    "./workflows/steps/load-cycle": {
      "types": "./dist/src/steps/load-cycle.d.ts",
      "import": "./dist/src/steps/load-cycle.js"
    },
    "./workflows/steps/protected-effect": {
      "types": "./dist/src/steps/protected-effect.d.ts",
      "import": "./dist/src/steps/protected-effect.js"
    },
    "./workflows/steps/decision-gate": {
      "types": "./dist/src/steps/decision-gate.d.ts",
      "import": "./dist/src/steps/decision-gate.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": "26.9.0",
    "npm": "11.19.1"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:workflows": "node tools/compile-workflows.ts",
    "self:start": "node tools/self-host.ts",
    "check:setup": "tsc --project tsconfig.json --noEmit",
    "check:quality": "node tools/check-quality.ts",
    "check:lint": "eslint src tools quality test eslint.config.mjs --max-warnings 0",
    "check:format": "prettier --check src tools quality test eslint.config.mjs package.json tsconfig.json tsconfig.build.json",
    "test:quality": "node --test test/quality/*.test.ts",
    "check": "node tools/quality-pending.ts",
    "test:concurrency": "node tools/quality-pending.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/node": "26.6.4",
    "@workflow/builders": "5.0.2",
    "acorn": "8.16.0",
    "ast-v8-to-istanbul": "1.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "istanbul-lib-coverage": "3.2.2",
    "jscpd": "5.4.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "@workflow/core": {
      "devalue": "5.9.4",
      "nanoid": "5.1.16"
    }
  },
  "dependencies": {
    "solid-objects": "0.17.8",
    "workflow": "5.1.0"
  }
}
