{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "checks": {
      "type": "object",
      "properties": {
        "beforeMerge": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "redGreen": {
          "type": "object",
          "properties": {
            "test": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[^\\u0000]+$"
              }
            },
            "testFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^\\u0000]+$"
              }
            },
            "prepare": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[^\\u0000]+$"
              }
            },
            "assertionPattern": {
              "type": "string"
            },
            "skipPattern": {
              "type": "string"
            }
          },
          "required": ["test", "testFiles"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "merge": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["direct", "queue"]
        }
      },
      "additionalProperties": false
    },
    "tickets": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nextCommand": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readyCommand": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "queue": {
      "type": "object",
      "properties": {
        "everySeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "dailySpendLimitUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lanes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "effects": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "chain": { "type": "integer", "minimum": 2, "maximum": 50 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloving project settings",
  "required": ["version"]
}
